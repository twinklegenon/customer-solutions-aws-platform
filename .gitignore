# Terraform working dir and plugins
.terraform/

# State (kept in the S3 backend, never in git)
*.tfstate
*.tfstate.*

# Variable values: ignored by default, but the per-environment files hold no secrets and are committed
*.tfvars
*.tfvars.json
!example.tfvars
!environments/*/*.tfvars

# Plan output
*.tfplan
tfplan
plan.out


# Credentials
.env
*.pem
*.key
.aws/

# do commit .terraform.lock.hcl
